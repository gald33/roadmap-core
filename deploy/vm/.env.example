# Copy to deploy/vm/.env (never commit it) and fill in.
ROADMAP_HOST=roadmap.lucille-ai.com
# The origin port Cloudflare's Origin Rule points at. On the Lucille VM, 8443 is
# Lucille's own Caddy and 8444 the switchboard hub; check it is free first.
ORIGIN_PORT=8445
ACME_EMAIL=
# A Cloudflare API token scoped to Zone:DNS:Edit for the zone, for DNS-01.
CLOUDFLARE_API_TOKEN=
